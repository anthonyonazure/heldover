# Optional. The setup screen in the app covers all of this; these are only
# for people who prefer to configure through the environment (settings saved
# in the app take priority). Bad values are named in the log at startup and
# replaced by their defaults, except BIND_HOST: a value there that cannot be
# used stops startup.
#
# PLEX_TOKEN=
# TMDB_API_KEY=            # https://www.themoviedb.org/settings/api
# OMDB_API_KEY=            # https://www.omdbapi.com/apikey.aspx
# OMDB_DAILY_LIMIT=950     # Free: 950, Patreon $1: 95000, Patreon $5: 245000
# MDBLIST_API_KEY=         # https://mdblist.com/preferences/
# MDBLIST_DAILY_LIMIT=1000
# FANART_API_KEY=          # https://fanart.tv/get-an-api-key/
# GOPEED_URL=http://localhost:9999   # only used when downloads are turned on
#
# DATA_DIR=                # database, poster cache, settings (default: server/data)
# FFMPEG_PATH=             # found automatically; set if ffmpeg lives somewhere unusual
# BIND_HOST=0.0.0.0        # the address to listen on. 0.0.0.0 (default): every device on your
#                          # network can open the app. 127.0.0.1 (or localhost): this computer
#                          # only. An IP address with nothing after it: no port, no quotes.
#                          # Anything else stops startup instead of opening the app to everyone.
# DISABLE_MDNS=1           # stop announcing heldover.local
# MDNS_NAME=heldover    # the .local name to announce
# ALLOWED_HOSTS=           # extra host names to accept, comma separated
# TRUST_PROXY=             # e.g. 1 when one reverse proxy sits in front
# PLEX_ALLOW_HTTP=1        # also talk to Plex servers over plain http (off by default: https only).
#                          # Any machine that answers at such an address can receive your Plex token.
# RESET_PIN=1              # set for one start to clear a forgotten PIN
# SERVE_STATIC=1           # serve the built client even when running from source
# CLIENT_PORT=3000         # the Vite dev server's port, for the address printed at startup
PORT=3001
